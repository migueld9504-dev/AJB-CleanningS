# AJB Cleaning Services - Hostinger (LiteSpeed)
# Si tras subirlo el sitio falla, renombra este archivo y avisa: es la marcha atras.

# Una sola version del sitio. www servia lo mismo sin redirigir: contenido duplicado.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://ajbcleaningservices.com%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Cabeceras de seguridad. El sitio en vivo no enviaba ninguna (revisado el 17-nov-2026).
<IfModule mod_headers.c>
  # Solo HTTPS durante un ano. Sin includeSubDomains: otros subdominios no se tocan.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Nadie puede meter el sitio en un iframe ajeno para engañar al visitante
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Los archivos de assets llevan hash en el nombre: se pueden guardar un ano
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>
